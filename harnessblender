def pour_targets(recipe: str) -> list[str]:
    """Install ids for a recipe: the main blend (if it has skills/agents/guidelines/mcps)
    plus each plugin ingredient separately (its own name from its own plugin.json — never
    merged, see rebuild_plugins()). Raises ValueError on failure — callers decide how to
    surface that (CLI: sys.exit, web: HTTP error)."""
    if not blend_dir(recipe).exists():
        raise ValueError(f"recipe '{recipe}' has not been blended yet — run `harnessblender blend {recipe}` first.")
    mix = read_recipe(recipe)
    c = counts(mix)
    ids: list[str] = []
    if any(c[k] for k in ("skill", "agent", "guideline", "mcp")):
        ids.append(recipe)
    plugins_dir = recipe_dir(recipe) / "plugins"
    if plugins_dir.is_dir():
        for p in sorted(plugins_dir.iterdir()):
            manifest = p / ".claude-plugin" / "plugin.json"
            if manifest.exists():
                ids.append(json.loads(manifest.read_text())["name"])
    if not ids:
        raise ValueError(f"recipe '{recipe}' has nothing to pour (empty selections).")
    return ids


def pour_one(recipe: str, market: str, ids: list[str], drinker: str, scope: str) -> dict:
    """Pour into a single drinker: `claude plugin marketplace add` + one `install` per id.
    Never raises — reports success/failure per id in the returned log."""
    target = Path(drinker).expanduser().resolve()
    if not target.is_dir():
        return {"drinker": drinker, "ok": False, "log": f"skip {drinker}: not a directory"}
    lines = [f"== pouring '{recipe}' ({', '.join(ids)}) into {target} (scope={scope}) =="]
    add = subprocess.run(["claude", "plugin", "marketplace", "add", str(ROOT)],
                         cwd=target, capture_output=True, text=True)
    if add.returncode != 0:
        lines.append(f"  marketplace add: {add.stdout.strip() or add.stderr.strip()} (continuing — likely already added)")
    ok = True
    for plugin_id in ids:
        install = subprocess.run(
            ["claude", "plugin", "install", f"{plugin_id}@{market}", "--scope", scope, "-y"],
            cwd=target, capture_output=True, text=True)
        if install.returncode != 0:
            ok = False
            lines.append(f"  ERROR ({plugin_id}): {install.stdout.strip() or install.stderr.strip()}")
            continue
        # `install` on an already-installed plugin is a no-op — it does NOT pick up new content
        # even if the recipe's blend changed. `update` is what actually refreshes it to the
        # version currently advertised by the marketplace (still needs a Claude Code restart
        # to take effect — that's a `claude` limitation, not something harnessblender can do).
        update = subprocess.run(
            ["claude", "plugin", "update", f"{plugin_id}@{market}", "--scope", scope, "-y"],
            cwd=target, capture_output=True, text=True)
        if update.returncode != 0:
            ok = False
            lines.append(f"  ERROR ({plugin_id}) update: {update.stdout.strip() or update.stderr.strip()}")
        else:
            lines.append(f"  {plugin_id}: {update.stdout.strip() or install.stdout.strip() or 'poured.'}")
    return {"drinker": drinker, "ok": ok, "log": "\n".join(lines)}


def cmd_pour(args) -> None:
    config = load_config()
    market = config.get("name") or ROOT.name
    try:
        ids = pour_targets(args.recipe)
    except ValueError as e:
        sys.exit(str(e))

    for drinker in args.drinkers:
        result = pour_one(args.recipe, market, ids, drinker, args.scope)
        print(result["log"], file=sys.stderr if not result["ok"] else sys.stdout)
    upsert_drinkers(args.recipe, [(d, args.scope) for d in args.drinkers])



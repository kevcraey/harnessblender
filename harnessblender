TOOL_DIR = Path(__file__).resolve().parent
ROOT: Path  # set by find_cookbook() at startup, once args are parsed

# kind <-> plural mapping. guideline = a loose .md file from a `guidelines` directory.
KIND_PLURAL = {"skill": "skills", "agent": "agents", "guideline": "guidelines", "mcp": "mcps", "plugin": "plugins"}
PLURAL_KIND = {v: k for k, v in KIND_PLURAL.items()}
PLURALS = ("skills", "agents", "guidelines", "mcps", "plugins")
# Kinds that end up copied into the blend. Not mcps: those get merged into
# plugin.json under `mcpServers` (no file to copy).
# Not plugins: those are already a complete standalone plugin (own plugin.json) and are
# NEVER merged into anything else — copied verbatim into recipes/<name>/plugins/<as>/
# and registered as their own marketplace entry. See rebuild_plugins().
COPY_PLURALS = ("skills", "agents", "guidelines")

# Junk that must never end up in a copied skill directory (bloat / not portable).
COPY_IGNORE = shutil.ignore_patterns(
    "__pycache__", "node_modules", ".git", ".venv", "venv", ".DS_Store", "*.pyc"
)

# Hook bundle that ends up in a blend as soon as any guidelines are selected.
# hooks/hooks.json is auto-discovered by Claude Code (no plugin.json field needed).
HOOKS_JSON = {
    "hooks": {
        "SessionStart": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": 'bash "${CLAUDE_PLUGIN_ROOT}/hooks/link-guidelines.sh"',
                    }
                ],
            }
        ]
    }
}

LINK_SCRIPT = """#!/usr/bin/env bash
# Symlinks this plugin's guidelines into the active project.
# Shipped by harnessblender; runs on every SessionStart. Idempotent.
src="${CLAUDE_PLUGIN_ROOT}/guidelines"
dst="${CLAUDE_PROJECT_DIR:-$PWD}/guidelines"
[ -d "$src" ] || exit 0
# Don't clobber if a REAL directory is already there (e.g. still-tracked guidelines).
if [ -e "$dst" ] && [ ! -L "$dst" ]; then
  exit 0
fi
ln -sfn "$src" "$dst" 2>/dev/null || true
exit 0
"""


# ── cookbook resolution ─────────────────────────────────────────────────────

def find_cookbook(explicit: str | None) -> Path:
    """Resolve the cookbook root: --cookbook if given, else walk up from cwd
    looking for a `cookbook.yaml` marker file."""
    if explicit:
        p = Path(explicit).expanduser().resolve()
        if not (p / "cookbook.yaml").is_file():
            sys.exit(f"not a cookbook (no cookbook.yaml here): {p}")
        return p
    cur = Path.cwd()
    for d in (cur, *cur.parents):
        if (d / "cookbook.yaml").is_file():
            return d
    sys.exit("no cookbook found (no cookbook.yaml in this dir or any parent). Pass --cookbook <path>.")


def load_config() -> dict:
    path = ROOT / "cookbook.yaml"
    if not path.exists():
        sys.exit(f"missing config: {path}")
    data = yaml.safe_load(path.read_text()) or {}
    data.setdefault("name", ROOT.name)
    return data


def load_store() -> list[dict]:
    path = ROOT / "store.yaml"
    if not path.exists():
        return []
    return (yaml.safe_load(path.read_text()) or {}).get("sources") or []


def write_store(sources: list[dict]) -> None:
    lines = [
        "# External sources harnessblender can fetch (\"store items\"). Each `name` is cloned to",
        "# `store/<name>/` (gitignored) — `harnessblender fetch` clones if missing, ff-only pulls",
        "# if it already exists.",
        "#",
        "# sources:",
        "#   - name: some-skill-repo",
        "#     url: git@github.com:someone/some-skill-repo.git",
    ]
    if not sources:
        lines.append("sources: []")
    else:
        lines.append("sources:")
        for s in sources:
            lines.append(f"  - name: {s['name']}")
            lines.append(f"    url: {s['url']}")
    (ROOT / "store.yaml").write_text("\n".join(lines) + "\n")


def remove_store_source(name: str, config: dict) -> None:
    """Drop a store.yaml source entirely: delete its store/<name>/ checkout, remove the
    store.yaml entry, and scrub it from every recipe's selections (re-blending affected ones).
    There's no per-item removal inside a store checkout — see the pitfalls in the skill's docs
    on why `store/` is never hand-edited; drop the whole source instead."""
    sources = load_store()
    remaining = [s for s in sources if s.get("name") != name]
    if len(remaining) == len(sources):
        raise ValueError(f"no such store source '{name}'")
    write_store(remaining)

    checkout = ROOT / "store" / name
    if checkout.exists():
        shutil.rmtree(checkout)

    prefix = f"store/{name}/"
    for rname in recipe_names():
        mix = read_recipe(rname)
        sels = mix.get("selections") or {}
        changed = False
        for plural in PLURALS:
            entries = sels.get(plural) or []
            kept = [e for e in entries if not str(e.get("source", "")).startswith(prefix)]
            if len(kept) != len(entries):
                sels[plural] = kept
                changed = True
        if changed:
            mix["selections"] = sels
            recipe_path(rname).write_text(yaml.safe_dump(mix, sort_keys=False))
            apply(rname, read_recipe(rname), config)


def scan_roots() -> list[str]:
    """Fixed scan bases: pantry/ + every store/<name>/. No more configurable scan_bases."""
    roots = ["pantry"]
    store_dir = ROOT / "store"
    if store_dir.is_dir():
        roots += [f"store/{d.name}" for d in sorted(store_dir.iterdir())
                  if d.is_dir() and not d.name.startswith(".")]
    return roots


@dataclass(frozen=True)
class Item:
    kind: str          # "skill" | "agent" | "guideline" | "mcp"
    root_label: str    # scan-root display (e.g. "pantry/skills" or "store/caveman/skills")
    name: str          # source basename (default plugin-side name)
    source: Path       # absolute path to source dir or file


def default_as(it: Item) -> str:
    """Default plugin-side name. A guidelines README.md loads as CLAUDE.md."""
    if it.kind == "guideline" and it.name == "README.md":
        return "CLAUDE.md"
    return it.name


def default_as_for(kind: str, name: str) -> str:
    if kind == "guideline" and name == "README.md":
        return "CLAUDE.md"
    return name


# Directories we never descend into during the walk.
EXCLUDE_DIRS = {"__pycache__", "node_modules", ".git", ".venv", "venv"}


def _collect_agents(d: Path, label: str, items: list[Item], seen: set[str]) -> None:
    for entry in sorted(d.iterdir()):
        is_agent = (entry.is_file() and entry.suffix == ".md") or (
            entry.is_dir() and (entry / f"{entry.name}.md").exists()
        )
        if is_agent and str(entry) not in seen:
            seen.add(str(entry))
            items.append(Item("agent", label, entry.name, entry))


def _collect_guidelines(d: Path, label: str, items: list[Item], seen: set[str]) -> None:
    for entry in sorted(d.iterdir()):
        if entry.is_file() and entry.suffix == ".md" and str(entry) not in seen:
            seen.add(str(entry))
            items.append(Item("guideline", label, entry.name, entry))


# MCP registry runtimeHint -> (command, prefix-args). The registry format (server.json)
# describes a package rather than a ready-made mcpServers config; for the simple
# cases (just identifier + runtimeHint) we derive the launch command from it.
_REGISTRY_RUNNERS = {
    "npx": ("npx", ["-y"]),
    "uvx": ("uvx", []),
    "dnx": ("dnx", []),
}
_REGISTRY_TYPE_RUNNER = {"npm": "npx", "pypi": "uvx", "nuget": "dnx"}


def _servers_from_registry(src: Path) -> dict:
    try:
        data = json.loads(src.read_text())
    except (json.JSONDecodeError, OSError):
        return {}
    packages = data.get("packages")
    if not isinstance(packages, list):
        return {}
    order = {"npm": 0, "pypi": 1, "nuget": 2}
    candidates = [p for p in packages if isinstance(p, dict)
                  and (p.get("transport") or {}).get("type", "stdio") == "stdio"]
    candidates.sort(key=lambda p: order.get(p.get("registryType"), 9))
    for pkg in candidates:
        if pkg.get("runtimeArguments") or pkg.get("packageArguments") or pkg.get("environmentVariables"):
            continue
        ident = pkg.get("identifier")
        runner = pkg.get("runtimeHint") or _REGISTRY_TYPE_RUNNER.get(pkg.get("registryType"))
        if not ident or runner not in _REGISTRY_RUNNERS:
            continue
        command, prefix = _REGISTRY_RUNNERS[runner]
        return {src.parent.name: {"command": command, "args": [*prefix, ident]}}
    return {}


def _servers_from_file(src: Path) -> dict:
    if src.name == "server.json":
        return _servers_from_registry(src)
    try:
        data = json.loads(src.read_text())
    except (json.JSONDecodeError, OSError):
        return {}
    servers = data.get("mcpServers")
    if isinstance(servers, dict):
        return servers
    if src.name == ".mcp.json":
        return {k: v for k, v in data.items() if isinstance(v, dict)}
    return {}


def _mcp_source(sub: Path) -> tuple[Path, dict] | None:
    for cand in (sub / ".mcp.json", sub / ".claude-plugin" / ".mcp.json",
                 sub / ".claude-plugin" / "plugin.json", sub / "server.json"):
        if cand.is_file():
            servers = _servers_from_file(cand)
            if servers:
                return cand, servers
    return None


def _collect_mcps(d: Path, label: str, items: list[Item], seen: set[str]) -> None:
    for sub in sorted(d.iterdir()):
        if not sub.is_dir() or sub.name.startswith("."):
            continue
        found = _mcp_source(sub)
        if found is None or str(sub) in seen:
            continue
        seen.add(str(sub))
        items.append(Item("mcp", label, sub.name, found[0]))


def discover_sources(bases: list[str], exclude_dirs: list[str] | None = None) -> list[Item]:
    """Walk `bases` (pantry/ + store/<name>/) and discover sources by convention.

    - directory with SKILL.md         -> skill   (grouped under its parent directory)
    - directory named `agents`        -> agents  (its .md / <name>/<name>.md entries)
    - directory named `guidelines`    -> guidelines (its loose .md files; `richtlijnen` also
                                         matches, as a legacy alias for external sources you
                                         don't control)
    - directory named `mcp-servers`   -> mcps    (subdirectories that declare mcpServers)
    """
    items: list[Item] = []
    seen: set[str] = set()
    excluded = EXCLUDE_DIRS | set(exclude_dirs or ())
    for base_raw in bases:
        base = (ROOT / base_raw).resolve()
        if not base.is_dir():
            print(f"warn: scan root missing: {base_raw}", file=sys.stderr)
            continue

        for dirpath, dirnames, _ in os.walk(base):
            d = Path(dirpath).resolve()
            dirnames[:] = [x for x in dirnames if not x.startswith(".") and x not in excluded]

            if d.name == "agents":
                _collect_agents(d, relpath(d), items, seen)
                dirnames[:] = []
                continue
            if d.name in ("guidelines", "richtlijnen"):  # richtlijnen: legacy alias, for external sources you don't control
                _collect_guidelines(d, relpath(d), items, seen)
                dirnames[:] = []
                continue
            if d.name == "mcp-servers":
                _collect_mcps(d, relpath(d), items, seen)
                dirnames[:] = []
                continue
            if (d / ".claude-plugin" / "plugin.json").exists():
                if str(d) not in seen:
                    seen.add(str(d))
                    items.append(Item("plugin", relpath(d.parent), d.name, d))
                # keep walking: a plugin repo (e.g. an external one) can also contain
                # individually-pickable skills/agents/guidelines/mcp-servers you want à la
                # carte, alongside the option to pour it whole as its own plugin.
                continue
            if (d / "SKILL.md").exists():
                if str(d) not in seen:
                    seen.add(str(d))
                    items.append(Item("skill", relpath(d.parent), d.name, d))
                dirnames[:] = []
                continue
    return items


def recipe_dir(name: str) -> Path:
    return ROOT / "recipes" / name


def recipe_path(name: str) -> Path:
    return recipe_dir(name) / "recipe.yaml"


def blend_dir(name: str) -> Path:
    return recipe_dir(name) / "blend"


def read_recipe(name: str) -> dict:
    p = recipe_path(name)
    return yaml.safe_load(p.read_text()) if p.exists() else {}


def collect_preselected(current: dict) -> set[str]:
    pre: set[str] = set()
    sels = (current.get("selections") or {})
    for plural in PLURALS:
        for sel in (sels.get(plural) or []):
            src = sel.get("source")
            if src:
                pre.add(str((ROOT / src).resolve()))
    return pre


def build_choices(items: list[Item], preselected_abs: set[str], guideline_check_all: bool) -> list:
    grouped: dict[str, list[Item]] = {}
    for it in items:
        grouped.setdefault(it.root_label, []).append(it)

    choices: list = []
    for root_label in sorted(grouped):
        choices.append(questionary.Separator(f"── {root_label} ──"))
        for it in sorted(grouped[root_label], key=lambda x: x.name):
            checked = str(it.source) in preselected_abs
            if it.kind == "guideline" and guideline_check_all:
                checked = True
            choices.append(questionary.Choice(title=it.name, value=it, checked=checked))
    return choices


PICK_STEPS = [
    ("skill", "SKILLS"),
    ("agent", "AGENTS"),
    ("guideline", "GUIDELINES"),
    ("mcp", "MCP SERVERS"),
    ("plugin", "PLUGINS (standalone, never merged)"),
]


def run_picker(items: list[Item], current: dict) -> list[Item]:
    pre = collect_preselected(current)
    guideline_check_all = "guidelines" not in (current.get("selections") or {})
    if not items:
        sys.exit("no ingredients found in pantry/ or store/.")

    selected: list[Item] = []
    for idx, (kind, label) in enumerate(PICK_STEPS, start=1):
        kind_items = [it for it in items if it.kind == kind]
        if not kind_items:
            continue
        choices = build_choices(kind_items, pre, guideline_check_all)
        result = questionary.checkbox(
            f"[{idx}/{len(PICK_STEPS)}] {label} (space toggle, enter confirm):",
            choices=choices,
        ).ask()
        if result is None:
            sys.exit("cancelled.")
        selected.extend(result)
    return selected


def existing_as_map(existing: dict) -> dict[tuple[str, str], str]:
    out: dict[tuple[str, str], str] = {}
    sels = existing.get("selections") or {}
    for kind, plural in KIND_PLURAL.items():
        for sel in (sels.get(plural) or []):
            src = sel.get("source")
            if not src:
                continue
            abs_src = str((ROOT / src).resolve())
            out[(kind, abs_src)] = sel.get("as") or default_as_for(kind, Path(src).name)
    return out


def find_conflicts(selected: list[Item], existing: dict) -> list[str]:
    existing_as = existing_as_map(existing)
    final_names: dict[tuple[str, str], Item] = {}
    msgs: list[str] = []
    for it in selected:
        key_source = (it.kind, str(it.source))
        as_name = existing_as.get(key_source) or default_as(it)
        final_key = (it.kind, as_name)
        if final_key in final_names:
            a = final_names[final_key]
            msgs.append(f"{a.kind} '{as_name}': {a.root_label} <-> {it.root_label}")
        else:
            final_names[final_key] = it
    return msgs


def check_conflicts(selected: list[Item], existing: dict) -> None:
    msgs = find_conflicts(selected, existing)
    if msgs:
        sys.exit("\n".join(
            ["name conflicts — pick only one, or set `as:` rename in the recipe and re-run:"]
            + [f"  {m}" for m in msgs]
        ))


def relpath(p: Path) -> str:
    try:
        return os.path.relpath(p, ROOT)
    except ValueError:
        return str(p)


def write_recipe(name: str, description: str, version: str, selected: list[Item], existing: dict) -> None:
    existing_as = existing_as_map(existing)
    by_kind: dict[str, list[dict]] = {plural: [] for plural in PLURALS}
    for it in selected:
        plural = KIND_PLURAL[it.kind]
        key = (it.kind, str(it.source))
        as_name = existing_as.get(key) or default_as(it)
        by_kind[plural].append({"source": relpath(it.source), "as": as_name})

    data = {"description": description, "version": version, "selections": by_kind,
             "drinkers": existing.get("drinkers") or []}
    p = recipe_path(name)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(yaml.safe_dump(data, sort_keys=False))


def set_drinkers(name: str, drinkers: list[dict]) -> None:
    mix = read_recipe(name)
    mix["drinkers"] = drinkers
    recipe_path(name).write_text(yaml.safe_dump(mix, sort_keys=False))


def upsert_drinkers(name: str, pairs: list[tuple[str, str]]) -> None:
    mix = read_recipe(name)
    by_path = {d["path"]: d for d in (mix.get("drinkers") or []) if d.get("path")}
    for path, scope in pairs:
        by_path[path] = {"path": path, "scope": scope}
    mix["drinkers"] = list(by_path.values())
    recipe_path(name).write_text(yaml.safe_dump(mix, sort_keys=False))


def recipe_names() -> list[str]:
    recipes_dir = ROOT / "recipes"
    if not recipes_dir.is_dir():
        return []
    return sorted(d.name for d in recipes_dir.iterdir()
                  if d.is_dir() and not d.name.startswith(".") and (d / "recipe.yaml").is_file())


def clear_dir(d: Path) -> None:
    if not d.exists():
        return
    for child in d.iterdir():
        if child.is_symlink() or child.is_file():
            child.unlink()
        else:
            shutil.rmtree(child)


def rebuild_items(blend: Path, mix: dict) -> None:
    sels = mix.get("selections") or {}
    for plural in COPY_PLURALS:
        d = blend / plural
        clear_dir(d)
        entries = sels.get(plural) or []
        if not entries:
            if d.exists():
                shutil.rmtree(d)
            continue
        d.mkdir(parents=True, exist_ok=True)
        for sel in entries:
            src = (ROOT / sel["source"]).resolve()
            if not src.exists():
                print(f"warn: source missing, skipping: {sel['source']}", file=sys.stderr)
                continue
            target = d / sel["as"]
            if src.is_dir():
                shutil.copytree(src, target, symlinks=False, ignore=COPY_IGNORE)
            else:
                shutil.copy2(src, target)


def rebuild_plugins(name: str, mix: dict) -> None:
    """Copy selected plugin ingredients verbatim into recipes/<name>/plugins/<as>/.
    Never merged into the blend — each plugin ingredient is already standalone (its own
    plugin.json) and gets registered as its own entry in write_marketplace_json."""
    d = recipe_dir(name) / "plugins"
    clear_dir(d)
    entries = (mix.get("selections") or {}).get("plugins") or []
    if not entries:
        if d.exists():
            shutil.rmtree(d)
        return
    d.mkdir(parents=True, exist_ok=True)
    for sel in entries:
        src = (ROOT / sel["source"]).resolve()
        if not src.exists():
            print(f"warn: source missing, skipping: {sel['source']}", file=sys.stderr)
            continue
        shutil.copytree(src, d / sel["as"], symlinks=False, ignore=COPY_IGNORE)


def write_hooks(blend: Path, mix: dict) -> bool:
    sels = mix.get("selections") or {}
    has_guidelines = bool(sels.get("guidelines"))
    hooks_dir = blend / "hooks"
    if not has_guidelines:
        if hooks_dir.exists():
            shutil.rmtree(hooks_dir)
        return False
    hooks_dir.mkdir(parents=True, exist_ok=True)
    (hooks_dir / "hooks.json").write_text(json.dumps(HOOKS_JSON, indent=2) + "\n")
    script = hooks_dir / "link-guidelines.sh"
    script.write_text(LINK_SCRIPT)
    script.chmod(0o755)
    return True


def collect_mcp_servers(mix: dict) -> tuple[dict, list[str]]:
    sels = mix.get("selections") or {}
    servers: dict = {}
    warnings: list[str] = []
    for sel in (sels.get("mcps") or []):
        src = (ROOT / sel["source"]).resolve()
        if not src.exists():
            warnings.append(f"mcp source missing, skipping: {sel['source']}")
            continue
        for key, cfg in _servers_from_file(src).items():
            if key in servers:
                warnings.append(f"duplicate MCP server '{key}' — keeping first")
                continue
            servers[key] = cfg
    return servers, warnings


def write_plugin_json(blend: Path, name: str, mix: dict) -> None:
    plugin_dir = blend / ".claude-plugin"
    plugin_dir.mkdir(parents=True, exist_ok=True)
    data = {
        "name": name,
        "description": mix.get("description", ""),
        "version": mix.get("version", "0.1.0"),
    }
    servers, warns = collect_mcp_servers(mix)
    for w in warns:
        print(f"warn: {w}", file=sys.stderr)
    if servers:
        data["mcpServers"] = servers
    (plugin_dir / "plugin.json").write_text(json.dumps(data, indent=2) + "\n")


def write_marketplace_json(config: dict) -> None:
    market_dir = ROOT / ".claude-plugin"
    market_dir.mkdir(parents=True, exist_ok=True)
    plugins = []
    seen_names: set[str] = set()

    def register(entry: dict) -> None:
        if entry["name"] in seen_names:
            print(f"warn: duplicate plugin name '{entry['name']}' in marketplace — keeping first "
                  f"(source: {entry['source']})", file=sys.stderr)
            return
        seen_names.add(entry["name"])
        plugins.append(entry)

    for name in recipe_names():
        mix = read_recipe(name)
        c = counts(mix)
        has_main_content = any(c[k] for k in ("skill", "agent", "guideline", "mcp"))
        if has_main_content:
            manifest = blend_dir(name) / ".claude-plugin" / "plugin.json"
            if manifest.exists():
                meta = json.loads(manifest.read_text())
                register({"name": meta["name"], "description": meta.get("description", ""),
                          "source": f"./recipes/{name}/blend"})

        # plugin-kind ingredients: already standalone, each its own marketplace entry —
        # never merged into the blend above (see rebuild_plugins()).
        plugins_dir = recipe_dir(name) / "plugins"
        if plugins_dir.is_dir():
            for p in sorted(plugins_dir.iterdir()):
                manifest = p / ".claude-plugin" / "plugin.json"
                if not manifest.exists():
                    continue
                meta = json.loads(manifest.read_text())
                register({"name": meta["name"], "description": meta.get("description", ""),
                          "source": f"./recipes/{name}/plugins/{p.name}"})
    data = {
        "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
        "name": config.get("name") or ROOT.name,

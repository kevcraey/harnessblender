# ── fetch: clone-if-missing + ff-only pull for every store source ───────────

def update_repo(repo: Path) -> dict:
    """Fetch + ff-only merge. Never auto-stashes or force-merges — a dirty tree,
    detached HEAD, or diverged branch is reported and left untouched."""
    label = relpath(repo)
    branch = _git(repo, "symbolic-ref", "-q", "--short", "HEAD")
    if not branch:
        head = _git(repo, "rev-parse", "--short", "HEAD") or "?"
        return {"repo": repo, "label": label, "status": "skipped",
                "reason": f"detached HEAD @ {head} (pinned on purpose?), not auto-updated"}

    dirty = _git_raw(repo, "status", "--porcelain", "--untracked-files=no")
    if dirty:
        paths = ", ".join(line[3:] for line in dirty.strip("\n").splitlines()[:5])
        return {"repo": repo, "label": label, "status": "skipped",
                "reason": f"dirty (tracked changes): {paths}"}

    old = _git(repo, "rev-parse", "HEAD")
    if _git(repo, "fetch", "origin", timeout=120) is None:
        return {"repo": repo, "label": label, "status": "error", "reason": "git fetch failed (network/auth?)"}

    if _git(repo, "merge", "--ff-only", f"origin/{branch}", timeout=30) is None:
        return {"repo": repo, "label": label, "status": "skipped",
                "reason": f"diverged from origin/{branch} (not fast-forwardable), left untouched"}

    new = _git(repo, "rev-parse", "HEAD")
    if old == new:
        return {"repo": repo, "label": label, "status": "up-to-date", "commit": new}
    commits = (_git(repo, "log", "--oneline", f"{old}..{new}") or "").splitlines()
    return {"repo": repo, "label": label, "status": "updated", "old": old, "new": new, "commits": commits}


def clone_repo(name: str, url: str) -> dict:
    dest = ROOT / "store" / name
    label = relpath(dest)
    dest.parent.mkdir(parents=True, exist_ok=True)
    r = subprocess.run(["git", "clone", "--quiet", url, str(dest)],
                        capture_output=True, text=True,
                        env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})
    if r.returncode != 0:
        return {"repo": dest, "label": label, "status": "error",
                "reason": f"git clone failed: {r.stderr.strip()[:200]}"}
    commit = _git(dest, "rev-parse", "--short", "HEAD") or "?"
    return {"repo": dest, "label": label, "status": "cloned", "commit": commit}


def stale_blends(updated: list[dict]) -> list[dict]:
    """Cross-check every blend's provenance.json against store repos that moved."""
    moved = [u for u in updated if u["status"] == "updated"]
    if not moved:
        return []
    out: list[dict] = []
    for name in recipe_names():
        prov_path = blend_dir(name) / "provenance.json"
        if not prov_path.exists():
            continue
        try:
            items = json.loads(prov_path.read_text()).get("items") or []
        except (OSError, json.JSONDecodeError):
            continue
        for item in items:
            if not item.get("versioned"):
                continue
            src = (ROOT / item["source"]).resolve()
            for u in moved:
                try:
                    src.relative_to(u["repo"])
                except ValueError:
                    continue
                if item.get("commit") != u["new"]:
                    out.append({"blend": name, "item": item.get("as") or item["source"],
                                "kind": item.get("kind"), "repo_label": u["label"],
                                "old": (item.get("commit") or "")[:7], "new": u["new"][:7]})
                break
    return out


def cmd_fetch(args) -> None:
    sources = load_store()
    if not sources:
        sys.exit("no sources in store.yaml.")

    results: list[dict] = []
    for src in sources:
        name, url = src.get("name"), src.get("url")
        if not name or not url:
            print(f"warn: skipping malformed store.yaml entry: {src}", file=sys.stderr)
            continue
        dest = ROOT / "store" / name
        if (dest / ".git").exists():
            results.append(update_repo(dest))
        else:
            results.append(clone_repo(name, url))

    for r in results:
        print(f"== {r['label']} ==")
        if r["status"] == "cloned":
            print(f"  cloned ({r['commit']})")
        elif r["status"] == "up-to-date":
            print(f"  up to date ({r['commit'][:7]})")
        elif r["status"] == "updated":
            n = len(r["commits"])
            print(f"  {n} new commit{'s' if n != 1 else ''} ({r['old'][:7]}..{r['new'][:7]}):")
            for line in r["commits"][:8]:
                print(f"    {line}")
            if n > 8:
                print(f"    ... and {n - 8} more")
        elif r["status"] == "skipped":
            print(f"  SKIPPED: {r['reason']}")
        else:
            print(f"  ERROR: {r['reason']}")
        print()

    stale = stale_blends(results)
    if stale:
        print("== stale blends (store source moved since last blend) ==")
        for s in stale:
            print(f"  {s['blend']}: {s['item']} ({s['kind']}) — {s['old']}..{s['new']}  [{s['repo_label']}]")
        print("\nRun `harnessblender blend <recipe>` to refresh.")
    elif any(r["status"] == "updated" for r in results):
        print("No blend items were affected by these updates.")


# ── pour: install a blend into a project via the Claude Code CLI ───────────

def cmd_pour(args) -> None:
    config = load_config()
    name = config.get("name") or ROOT.name
    if not blend_dir(args.recipe).exists():
        sys.exit(f"recipe '{args.recipe}' has not been blended yet — run `harnessblender blend {args.recipe}` first.")

    for drinker in args.drinkers:
        target = Path(drinker).expanduser().resolve()
        if not target.is_dir():
            print(f"skip {drinker}: not a directory", file=sys.stderr)
            continue
        print(f"== pouring '{args.recipe}' into {target} (scope={args.scope}) ==")
        add = subprocess.run(["claude", "plugin", "marketplace", "add", str(ROOT)],
                             cwd=target, capture_output=True, text=True)
        if add.returncode != 0:
            print(f"  marketplace add: {add.stdout.strip() or add.stderr.strip()} (continuing — likely already added)")
        install = subprocess.run(
            ["claude", "plugin", "install", f"{args.recipe}@{name}", "--scope", args.scope, "-y"],
            cwd=target, capture_output=True, text=True)
        if install.returncode != 0:
            print(f"  ERROR: {install.stdout.strip() or install.stderr.strip()}", file=sys.stderr)
        else:
            print(f"  {install.stdout.strip() or 'poured.'}")


# ── web UI (stdlib only) ─────────────────────────────────────────────────────

WEB_DIR = TOOL_DIR / "web"
DEFAULT_PORT = 17345
CONTENT_TYPES = {".html": "text/html", ".js": "text/javascript", ".css": "text/css"}


def list_variants() -> list[dict]:
    """Alle recipes + hun huidige selectie (source-relpaths) voor de web-UI.
    (Veldnamen blijven `variant`/`variants` — dat is het JSON-contract dat app.js verwacht.)"""
    out: list[dict] = []
    for name in recipe_names():
        mix = read_recipe(name)
        sels = mix.get("selections") or {}
        sources = [sel["source"] for plural in PLURALS for sel in (sels.get(plural) or []) if sel.get("source")]
        out.append({
            "name": name,
            "description": mix.get("description", ""),
            "counts": counts(mix),
            "sources": sources,
        })
    return out


def web_state(items: list[Item], config: dict) -> dict:
    return {
        "items": [
            {"kind": it.kind, "root_label": it.root_label, "name": it.name,
             "source": relpath(it.source), "as": default_as(it)}
            for it in items
        ],
        "variants": list_variants(),
        "scan_bases": scan_roots(),
        "exclude_dirs": list(config.get("exclude_dirs") or []),
    }


def write_config(data: dict) -> None:
    """Herschrijft cookbook.yaml (behoudt name/owner/exclude_dirs mét commentaar)."""
    owner = data.get("owner") or {"name": "Kenzo", "url": ""}
    lines = [
        "# harnessblender-cookbook marker file.",
        f"name: {data.get('name') or ROOT.name}",
        "owner:",
        f"  name: {owner.get('name', 'Kenzo')}",
        f'  url: "{owner.get("url", "")}"',
        "",
        "exclude_dirs:",
    ]
    lines += [f"  - {e}" for e in (data.get("exclude_dirs") or [])]
    (ROOT / "cookbook.yaml").write_text("\n".join(lines) + "\n")


def save_variant(config: dict, items: list[Item], payload: dict) -> dict:
    """Schrijf/overschrijf + blend een recipe vanuit een web-payload. Raise ValueError op fout."""
    name = (payload.get("variant") or "").strip()
    if not name or name.startswith(".") or "/" in name or os.sep in name:
        raise ValueError("invalid recipe name")
    existing = read_recipe(name)

    by_rel = {relpath(it.source): it for it in items}
    selected = [by_rel[r] for r in (payload.get("sources") or []) if r in by_rel]

    conflicts = find_conflicts(selected, existing)
    if conflicts:
        raise ValueError("name conflicts:\n" + "\n".join(conflicts))

    description = payload.get("description")
    if description is None:
        description = existing.get("description", "")
    version = existing.get("version", "0.1.0")

    write_recipe(name, description, version, selected, existing)
    mix = read_recipe(name)
    has_hook = apply(name, mix, config)
    return {"ok": True, "counts": counts(mix), "hook": has_hook}


def make_handler(config: dict):
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *_a):
            pass

        def _json(self, obj, code=200):
            body = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("content-type", "application/json")
            self.send_header("content-length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def _static(self, rel: str):
            safe = (WEB_DIR / rel).resolve()
            if WEB_DIR not in safe.parents and safe != WEB_DIR or not safe.is_file():
                self.send_error(404)
                return
            body = safe.read_bytes()
            self.send_response(200)
            self.send_header("content-type", CONTENT_TYPES.get(safe.suffix, "application/octet-stream"))
            self.send_header("content-length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.path == "/api/state":
                items = discover_sources(scan_roots(), config.get("exclude_dirs"))
                self._json(web_state(items, config))
            elif self.path in ("/", "/index.html"):
                self._static("index.html")
            else:
                self._static(self.path.lstrip("/"))

        def do_POST(self):
            if self.path not in ("/api/save", "/api/config"):
                self.send_error(404)
                return
            length = int(self.headers.get("content-length") or 0)
            try:
                payload = json.loads(self.rfile.read(length) or b"{}")
                if self.path == "/api/config":
                    raw = payload.get("exclude_dirs") or []
                    clean = sorted({str(x).strip() for x in raw if str(x).strip() and "/" not in str(x)})
                    config["exclude_dirs"] = clean
                    write_config(config)
                    items = discover_sources(scan_roots(), clean)
                    self._json(web_state(items, config))
                    return
                items = discover_sources(scan_roots(), config.get("exclude_dirs"))
                self._json(save_variant(config, items, payload))
            except ValueError as e:
                self._json({"error": str(e)}, code=409)
            except Exception as e:  # noqa: BLE001
                self._json({"error": f"{type(e).__name__}: {e}"}, code=500)

    return Handler


def cmd_web(args) -> None:
    config = load_config()
    if not (WEB_DIR / "index.html").is_file():
        sys.exit(f"missing web assets: {WEB_DIR}/index.html")
    httpd = ThreadingHTTPServer(("127.0.0.1", args.port), make_handler(config))
    url = f"http://127.0.0.1:{args.port}/"
    print(f"harnessblender web → {url}  (cookbook: {ROOT})  (Ctrl-C to stop)")
    if not args.no_open:
        try:
            webbrowser.open(url)
        except Exception:  # noqa: BLE001
            pass
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped.")
    finally:
        httpd.server_close()


def main() -> None:
    p = argparse.ArgumentParser(
        prog="harnessblender",
        description="blend ingredients (skills/agents/richtlijnen/mcp servers) from a cookbook into installable Claude Code plugins",
    )
    p.add_argument("--cookbook", help="path to the cookbook (default: walk up from cwd for cookbook.yaml)")
    sub = p.add_subparsers(dest="cmd", required=True)

    pn = sub.add_parser("new-recipe", help="create a new recipe (picker) and blend it")
    pn.add_argument("recipe")
    pn.set_defaults(func=cmd_new_recipe)

    pe = sub.add_parser("edit-recipe", help="edit an existing recipe (picker pre-checked) and re-blend it")
    pe.add_argument("recipe")
    pe.set_defaults(func=cmd_edit_recipe)

    pb = sub.add_parser("blend", help="(re)build a blend from its recipe (no picker)")
    pb.add_argument("recipe")
    pb.set_defaults(func=cmd_blend)

    pl = sub.add_parser("list", help="list all recipes")
    pl.set_defaults(func=cmd_list)

    pf = sub.add_parser("fetch", help="clone-if-missing + ff-only pull every store.yaml source, report stale blends")
    pf.set_defaults(func=cmd_fetch)

    pp = sub.add_parser("pour", help="install a blend into one or more drinkers (project folders)")
    pp.add_argument("recipe")
    pp.add_argument("drinkers", nargs="+", help="project folder(s) to pour into")
    pp.add_argument("--scope", choices=["local", "project", "user"], default="local")
    pp.set_defaults(func=cmd_pour)

    pw = sub.add_parser("web", help="open the browser UI (new/edit recipes)")
    pw.add_argument("--port", type=int, default=DEFAULT_PORT)
    pw.add_argument("--no-open", action="store_true", help="don't auto-open the browser")
    pw.set_defaults(func=cmd_web)

    args = p.parse_args()
    global ROOT
    ROOT = find_cookbook(args.cookbook)
    args.func(args)


if __name__ == "__main__":
    main()

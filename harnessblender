def save_variant(config: dict, items: list[Item], payload: dict) -> dict:
    """Write/overwrite + blend a recipe from a web payload. Raises ValueError on failure."""
    name = (payload.get("variant") or "").strip()
    if not name or name.startswith(".") or "/" in name or os.sep in name:
        raise ValueError("invalid recipe name")
    existing = read_recipe(name)

    by_rel = {relpath(it.source): it for it in items}
    selected = [by_rel[r] for r in (payload.get("sources") or []) if r in by_rel]

    conflicts = find_conflicts(selected, existing)
    if conflicts:
        raise ValueError("name conflicts:\n" + "\n".join(conflicts))

    description = payload.get("description")
    if description is None:
        description = existing.get("description", "")
    version = existing.get("version", "0.1.0")

    write_recipe(name, description, version, selected, existing)
    mix = read_recipe(name)
    has_hook = apply(name, mix, config)
    return {"ok": True, "counts": counts(mix), "hook": has_hook}


def open_target(kind: str, source: Path) -> Path:
    """Resolve the file a browser "open" click should actually launch — a skill/agent
    directory opens its SKILL.md / <name>.md, everything else opens as-is."""
    if kind == "skill" and source.is_dir():
        return source / "SKILL.md"
    if kind == "agent" and source.is_dir():
        return source / f"{source.name}.md"
    return source


def delete_target(kind: str, root_label: str, name: str, source: Path) -> Path:
    """The actual file/dir to remove for an ingredient. For most kinds `source` already IS
    the whole ingredient; an mcp Item's source is just the config file discovery matched
    (e.g. `<wrapper>/.claude-plugin/.mcp.json`) — reconstruct the whole `<wrapper>/` dir."""
    if kind == "mcp":
        return ROOT / root_label / name
    return source


def delete_ingredient(kind: str, root_label: str, name: str, source: Path, config: dict) -> None:
    """Delete an ingredient's real files from the pantry, then scrub it from every recipe's
    selections (re-blending any recipe that referenced it). Refuses store/ sources — those are
    gitignored checkouts, never edited directly (see `fetch`); remove the store.yaml entry instead."""
    if Path(root_label).parts[:1] != ("pantry",):
        raise ValueError("only pantry ingredients can be deleted here — edit store.yaml for store/ sources")
    target = delete_target(kind, root_label, name, source).resolve()
    if ROOT != target and ROOT not in target.parents:
        raise ValueError("refusing to delete outside the cookbook")
    if target.is_dir():
        shutil.rmtree(target)
    elif target.exists():
        target.unlink()

    rel = relpath(source)
    for rname in recipe_names():
        mix = read_recipe(rname)
        sels = mix.get("selections") or {}
        changed = False
        for plural in PLURALS:
            entries = sels.get(plural) or []
            kept = [e for e in entries if e.get("source") != rel]
            if len(kept) != len(entries):
                sels[plural] = kept
                changed = True
        if changed:
            mix["selections"] = sels
            recipe_path(rname).write_text(yaml.safe_dump(mix, sort_keys=False))
            apply(rname, read_recipe(rname), config)


def open_in_os(path: Path) -> None:
    """Open a local file/dir with whatever the OS considers its default app."""
    if sys.platform == "darwin":
        subprocess.run(["open", str(path)])
    elif sys.platform.startswith("win"):
        os.startfile(str(path))  # noqa: S606 — Windows-only API
    else:
        subprocess.run(["xdg-open", str(path)])


def pick_folder() -> str | None:
    """Native folder-picker dialog. Returns the chosen absolute path, or None if cancelled
    (or unsupported on this OS — only macOS is implemented, matching the rest of this tool)."""
    if sys.platform != "darwin":
        return None
    script = 'POSIX path of (choose folder with prompt "Pick a drinker project folder")'
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if r.returncode != 0:
        return None
    return r.stdout.strip()


def make_handler(config: dict):
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *_a):
            pass

        def _json(self, obj, code=200):
            body = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("content-type", "application/json")
            self.send_header("content-length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def _static(self, rel: str):
            safe = (WEB_DIR / rel).resolve()
            if WEB_DIR not in safe.parents and safe != WEB_DIR or not safe.is_file():
                self.send_error(404)
                return
            body = safe.read_bytes()
            self.send_response(200)
            self.send_header("content-type", CONTENT_TYPES.get(safe.suffix, "application/octet-stream"))
            self.send_header("content-length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.path == "/api/state":
                items = discover_sources(scan_roots(), config.get("exclude_dirs"))
                self._json(web_state(items, config))
            elif self.path in ("/", "/index.html"):
                self._static("index.html")
            else:
                self._static(self.path.lstrip("/"))

        def do_POST(self):
            if self.path not in ("/api/save", "/api/config", "/api/delete", "/api/delete-source",
                                  "/api/remove-store", "/api/open", "/api/set-drinkers", "/api/pour-one",
                                  "/api/pick-folder", "/api/rename-recipe"):
                self.send_error(404)
                return
            length = int(self.headers.get("content-length") or 0)
            try:
                payload = json.loads(self.rfile.read(length) or b"{}")
                if self.path == "/api/rename-recipe":
                    old = (payload.get("old") or "").strip()
                    new = (payload.get("new") or "").strip()
                    rename_recipe(old, new, config)
                    self._json(web_state(discover_sources(scan_roots(), config.get("exclude_dirs")), config))
                    return
                if self.path == "/api/pick-folder":
                    path = pick_folder()
                    if path is None:
                        raise ValueError("cancelled or unsupported on this OS")
                    self._json({"path": path})
                    return
                if self.path == "/api/open":
                    rel = payload.get("source") or ""
                    src = (ROOT / rel).resolve()
                    if ROOT not in src.parents and src != ROOT or not src.exists():
                        raise ValueError(f"no such source '{rel}'")
                    open_in_os(open_target(payload.get("kind") or "", src))
                    self._json({"ok": True})
                    return
                if self.path == "/api/delete-source":
                    rel = payload.get("source") or ""
                    src = (ROOT / rel).resolve()
                    if ROOT not in src.parents and src != ROOT or not src.exists():
                        raise ValueError(f"no such source '{rel}'")
                    delete_ingredient(payload.get("kind") or "", payload.get("root_label") or "",
                                       payload.get("name") or "", src, config)
                    items = discover_sources(scan_roots(), config.get("exclude_dirs"))
                    self._json(web_state(items, config))
                    return
                if self.path == "/api/set-drinkers":
                    name = (payload.get("variant") or "").strip()
                    if not name or not recipe_path(name).exists():
                        raise ValueError(f"no such recipe '{name}'")
                    drinkers = [{"path": d.get("path"), "scope": d.get("scope") or "local"}
                                for d in (payload.get("drinkers") or []) if d.get("path")]
                    set_drinkers(name, drinkers)
                    self._json(web_state(discover_sources(scan_roots(), config.get("exclude_dirs")), config))
                    return
                if self.path == "/api/pour-one":
                    name = (payload.get("variant") or "").strip()
                    path = (payload.get("path") or "").strip()
                    scope = payload.get("scope") or "local"
                    if not name or not recipe_path(name).exists():
                        raise ValueError(f"no such recipe '{name}'")
                    if not path:
                        raise ValueError("drinker path required")
                    market = config.get("name") or ROOT.name
                    ids = pour_targets(name)
                    result = pour_one(name, market, ids, path, scope)
                    if result["ok"]:
                        upsert_drinkers(name, [(path, scope)])
                    self._json(result, code=200 if result["ok"] else 500)
                    return
                if self.path == "/api/remove-store":
                    name = (payload.get("name") or "").strip()
                    if not any(s.get("name") == name for s in load_store()):
                        raise ValueError(f"no such store source '{name}'")
                    remove_store_source(name, config)
                    items = discover_sources(scan_roots(), config.get("exclude_dirs"))
                    self._json(web_state(items, config))
                    return
                if self.path == "/api/config":
                    raw = payload.get("exclude_dirs") or []
                    clean = sorted({str(x).strip() for x in raw if str(x).strip() and "/" not in str(x)})
                    config["exclude_dirs"] = clean
                    write_config(config)
                    items = discover_sources(scan_roots(), clean)
                    self._json(web_state(items, config))
                    return
                if self.path == "/api/delete":
                    name = (payload.get("variant") or "").strip()
                    if not name or not recipe_path(name).exists():
                        raise ValueError(f"no such recipe '{name}'")
                    delete_recipe(name, config)
                    items = discover_sources(scan_roots(), config.get("exclude_dirs"))
                    self._json(web_state(items, config))
                    return
                items = discover_sources(scan_roots(), config.get("exclude_dirs"))
                self._json(save_variant(config, items, payload))
            except ValueError as e:
                self._json({"error": str(e)}, code=409)
            except Exception as e:  # noqa: BLE001
                self._json({"error": f"{type(e).__name__}: {e}"}, code=500)

    return Handler


def cmd_web(args) -> None:
    config = load_config()
    if not (WEB_DIR / "index.html").is_file():
        sys.exit(f"missing web assets: {WEB_DIR}/index.html")
    httpd = ThreadingHTTPServer(("127.0.0.1", args.port), make_handler(config))
    url = f"http://127.0.0.1:{args.port}/"
    print(f"harnessblender web → {url}  (cookbook: {ROOT})  (Ctrl-C to stop)")
    if not args.no_open:
        try:
            webbrowser.open(url)
        except Exception:  # noqa: BLE001
            pass
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped.")
    finally:
        httpd.server_close()


def main() -> None:
    p = argparse.ArgumentParser(
        prog="harnessblender",
        description="blend ingredients (skills/agents/guidelines/mcp servers) from a cookbook into installable Claude Code plugins",
    )
    p.add_argument("--cookbook", help="path to the cookbook (default: walk up from cwd for cookbook.yaml)")
    sub = p.add_subparsers(dest="cmd", required=True)

    pi = sub.add_parser("init", help="scaffold a new, empty cookbook")
    pi.add_argument("path", nargs="?", default=".", help="directory to create the cookbook in (default: .)")
    pi.add_argument("--name", help="cookbook name (default: target directory name)")
    pi.set_defaults(func=cmd_init)

    pn = sub.add_parser("new-recipe", help="create a new recipe (picker) and blend it")
    pn.add_argument("recipe")
    pn.set_defaults(func=cmd_new_recipe)

    pe = sub.add_parser("edit-recipe", help="edit an existing recipe (picker pre-checked) and re-blend it")
    pe.add_argument("recipe")
    pe.set_defaults(func=cmd_edit_recipe)

    pd = sub.add_parser("delete-recipe", help="delete a recipe (recipe.yaml + blend/)")
    pd.add_argument("recipe")
    pd.add_argument("-y", "--yes", action="store_true", help="skip confirmation")
    pd.set_defaults(func=cmd_delete_recipe)

    pb = sub.add_parser("blend", help="(re)build a blend from its recipe (no picker)")
    pb.add_argument("recipe")
    pb.set_defaults(func=cmd_blend)

    pl = sub.add_parser("list", help="list all recipes")
    pl.set_defaults(func=cmd_list)

    pf = sub.add_parser("fetch", help="clone-if-missing + ff-only pull every store.yaml source, report stale blends")
    pf.set_defaults(func=cmd_fetch)

    prs = sub.add_parser("remove-store", help="remove a store.yaml source (checkout + entry + recipe references)")
    prs.add_argument("name")
    prs.add_argument("-y", "--yes", action="store_true", help="skip confirmation")
    prs.set_defaults(func=cmd_remove_store)

    pp = sub.add_parser("pour", help="install a blend into one or more drinkers (project folders)")
    pp.add_argument("recipe")
    pp.add_argument("drinkers", nargs="+", help="project folder(s) to pour into")
    pp.add_argument("--scope", choices=["local", "project", "user"], default="local")
    pp.set_defaults(func=cmd_pour)

    pw = sub.add_parser("web", help="open the browser UI (new/edit recipes)")
    pw.add_argument("--port", type=int, default=DEFAULT_PORT)
    pw.add_argument("--no-open", action="store_true", help="don't auto-open the browser")
    pw.set_defaults(func=cmd_web)

    args = p.parse_args()
    if args.cmd == "init":
        cmd_init(args)
        return
    global ROOT
    ROOT = find_cookbook(args.cookbook)
    args.func(args)


if __name__ == "__main__":
    main()

# kind <-> plural mapping. richtlijn = los .md-bestand uit een `richtlijnen`-map.
KIND_PLURAL = {"skill": "skills", "agent": "agents", "richtlijn": "richtlijnen", "mcp": "mcps"}
PLURAL_KIND = {v: k for k, v in KIND_PLURAL.items()}
PLURALS = ("skills", "agents", "richtlijnen", "mcps")
# Soorten die als kopie in de blend belanden. mcps niet: die worden in
# plugin.json onder `mcpServers` samengevoegd (geen bestand om te kopiëren).
COPY_PLURALS = ("skills", "agents", "richtlijnen")


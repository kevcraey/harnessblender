    items = discover_sources(scan_roots(), config.get("exclude_dirs"))
    selected = run_picker(items, {})
    check_conflicts(selected, {})

    write_recipe(args.recipe, description or "", "0.1.0", selected, {})
    mix = read_recipe(args.recipe)
    has_hook = apply(args.recipe, mix, config)
    print(f"new recipe '{args.recipe}', blended: {summary(mix, has_hook)}.")


def cmd_edit_recipe(args) -> None:
